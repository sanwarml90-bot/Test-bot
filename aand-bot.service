[Unit]
Description=Aand TTS Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# NOTE: neeche ke paths apne VPS ke hisab se badlo.
# Bot files jahan extract kiye hain, wahi path daalo.
User=root
WorkingDirectory=/root/aand_bot
ExecStart=/usr/bin/python3 -u /root/aand_bot/bot.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
